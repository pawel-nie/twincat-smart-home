<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="UpStopDownButton" Id="{c21751f0-94cd-4281-8a12-825434e0a956}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK UpStopDownButton

VAR CONSTANT
	MAX_OUTPUTS_PER_LEVEL : INT := 3;
END_VAR

VAR_INPUT
	ID : INT;
	name : STRING := 'UpStopDown button';
	digitalInput : REFERENCE TO BOOL;
	outputs : REFERENCE TO ARRAY[1..MAX_OUTPUTS_PER_LEVEL] OF BOOL;
	defaultFirstClickDirection : E_Direction;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	pressed : R_TRIG;
	state : E_Direction := E_Direction.STOP;
    previousState : E_Direction := E_Direction.STOP;
	returnTimer : TP := (PT := T#500MS);
	
	readyToRelease : BOOL := FALSE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="getSource" Id="{011f2438-7f45-4b2c-917a-d6c792813ebc}">
      <Declaration><![CDATA[METHOD getSource : STRING
VAR_INPUT
END_VAR

VAR
	details : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[details := CONCAT(STR1:=' - up-stop-down button, ID: ', STR2:=TO_STRING(ID));
details := CONCAT(STR1:=details, STR2:=', digital input: ');
details := CONCAT(STR1:=details, STR2:=TO_STRING(digitalInput));
details := CONCAT(STR1:=details, STR2:=', name: ');
details := CONCAT(STR1:=details, STR2:=name);

getSource := details;]]></ST>
      </Implementation>
    </Method>
    <Method Name="loop" Id="{861e1e23-302c-481b-b4f4-9dde532c9d09}">
      <Declaration><![CDATA[METHOD loop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pressed(CLK:= digitalInput);
returnTimer(IN:= pressed.Q);

IF pressed.Q THEN
	readyToRelease := TRUE;
	
	GVL.EventLogger.print3(level:= TcEventSeverity.Verbose, str1:='Just before pressing Previous state=', str2:= TO_STRING(previousState), str3:=getSource());
	GVL.EventLogger.print3(level:= TcEventSeverity.Verbose, str1:='Just before pressing Current state=', str2:=TO_STRING(state), str3:=getSource());
	GVL.EventLogger.print3(level:= TcEventSeverity.Info, str1:='Pressed button=', str2:='', str3:=getSource());
	
	manageStatesAfterPressed();
	
	GVL.EventLogger.print3(level:= TcEventSeverity.Verbose, str1:='After pressing Previous state=', str2:= TO_STRING(previousState), str3:=getSource());
	GVL.EventLogger.print3(level:= TcEventSeverity.Verbose, str1:='After pressing Current state=', str2:=TO_STRING(state), str3:=getSource());

	setOutputs(state:= TRUE);

END_IF

IF NOT returnTimer.Q AND readyToRelease THEN
	setOutputs(state:= FALSE);
	readyToRelease := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="manageStatesAfterPressed" Id="{028a1be3-523b-4d61-84bd-9cf14dcd7d0e}">
      <Declaration><![CDATA[METHOD manageStatesAfterPressed
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE state OF
	E_Direction.STOP:
		CASE previousState OF
			E_Direction.STOP:
				state := defaultFirstClickDirection;
			E_Direction.DOWN:
				state := E_Direction.UP;
			E_Direction.UP:
				state := E_Direction.DOWN;
		END_CASE
		previousState := E_Direction.STOP;
		
	E_Direction.DOWN:
		state := E_Direction.STOP;
		previousState := E_Direction.DOWN;
		
	E_Direction.UP:
		state := E_Direction.STOP;
		previousState := E_Direction.UP;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="setOutputs" Id="{7152aa92-f9b3-4e40-b832-8e5d45ddeec6}">
      <Declaration><![CDATA[METHOD setOutputs
VAR_INPUT
	state : BOOL;
END_VAR

VAR
	i : INT;
	state_as_text : STRING := 'abc';
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[state_as_text := TO_STRING(state);

GVL.EventLogger.print3(level:=TcEventSeverity.Info, str1:='Set outputs to: ', str2:= state_as_text, str3:=getSource());
FOR i := 1 TO MAX_OUTPUTS_PER_LEVEL BY 1 DO
	outputs[i] := state;
END_FOR
]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="UpStopDownButton">
      <LineId Id="9" Count="0" />
    </LineIds>
    <LineIds Name="UpStopDownButton.getSource">
      <LineId Id="5" Count="0" />
