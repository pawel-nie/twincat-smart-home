      <LineId Id="84" Count="1" />
      <LineId Id="88" Count="11" />
      <LineId Id="115" Count="1" />
      <LineId Id="106" Count="5" />
      <LineId Id="68" Count="0" />
    </LineIds>
    <LineIds Name="UpStopDownButton.manageStatesAfterPressed">
      <LineId Id="6" Count="18" />
      <LineId Id="5" Count="0" />
    </LineIds>
    <LineIds Name="UpStopDownButton.setOutputs">
      <LineId Id="88" Count="0" />
      <LineId Id="105" Count="1" />
      <LineId Id="94" Count="2" />
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>