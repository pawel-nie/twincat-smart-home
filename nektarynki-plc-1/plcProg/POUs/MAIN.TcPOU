<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="MAIN" Id="{ba37e07b-b35e-420a-a01b-24b84cc886a6}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	initialized : BOOL := FALSE;
	serviceMode : BOOL := FALSE;
	stThisIsFirstInstanceOfAStructure : ST_Event;

	eEventType : E_EventType := E_EventType.Alarm;
	eEventSeverity : TcEventSeverity := TcEventSeverity.Info;
	nEventIdentity : UDINT := 44444;
	sEventText : STRING(255) := 'Some informational event';
	
	groupController : GroupController;
	
//	CsvPersistentEventStorage : FB_CsvPersistentEventStorage;
//	EventLogger : EventLogger(CsvPersistentEventStorage);

	wlaczniki_rolet_i_zaluzji : ARRAY[1..GVL.MAX_SHUTTERS] OF POINTER TO ShutterSwitch;
	wlacznik_1_zaluzja_pralnia : ShutterSwitch();
	wlacznik_2_zaluzje_kuchnia : ShutterSwitch();
	wlacznik_3_zaluzje_wykusz : ShutterSwitch();
	wlacznik_4_zaluzja_slide : ShutterSwitch();
    wlacznik_5_zaluzja_gabinet : ShutterSwitch();
    wlacznik_6_zaluzja_balkon : ShutterSwitch();
    wlacznik_7_zaluzja_nad_tarasem : ShutterSwitch();
	wlacznik_8_zaluzja_okno_bez_balkonu : ShutterSwitch();
	wlacznik_9_roleta_kotlownia : ShutterSwitch();
	wlacznik_10_roleta_warsztat : ShutterSwitch();
    wlacznik_11_rolety_garaz : ShutterSwitch();
	
	wlaczniki_swiatel : ARRAY[1..GVL.MAX_LIGHTS] OF POINTER TO LightSwitch;
	wlacznik_12_pralnia : LightSwitch();
	wlacznik_17_schody : LightSwitch();
	
		arr1 : ARRAY[1..3] OF BOOL;
		arr2 : ARRAY[1..3] OF BOOL;
		arr3 : ARRAY[1..3] OF BOOL;
		arr4 : ARRAY[1..3] OF BOOL;
		
		
		arr5 : ARRAY[1..2] OF BOOL;
		arr6 : ARRAY[1..2] OF BOOL;
		
		//button1 : LightSwitch;//ShutterSwitch;//LightSwitch;//UpStopDownButton;// LightSwitch;	
		//button2 : ShutterSwitch;
		//buttontest : ShutterSwitch;
		
		
		

		prosteWlaczniki : ARRAY[1..10] OF SimpleButton;
		wlacznikiTrojpozycyjne : ARRAY[1..10] OF UpStopDownButton;
		
	isDay : BOOL := TRUE;
	minimumLogSeverity : TcEventSeverity := TcEventSeverity.Verbose;
END_VAR

VAR_IN_OUT

END_VAR


]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT initialized THEN
	systemService();
	IF serviceMode THEN
		JMP _programBypass;
	END_IF
	GVL.EventLogger.print1(level:=TcEventSeverity.Info, str1:='PLC started');
	
	//todo print date, all inputs and outputs values 
			//initButtons();	
	
	initializeButtons();
			F_UpdateEventTimestampWithSystemTime(stEvent := stThisIsFirstInstanceOfAStructure);	
			GVL.EventLogger.AddEvent(eEventType, eEventSeverity, nEventIdentity, sEventText);
			
	initialized := TRUE;
	groupController(shutters:= wlaczniki_rolet_i_zaluzji, smartLights:= wlaczniki_swiatel);

END_IF


//-------------------------------

//CsvPersistentEventStorage();


//buttontest.loop();

inputsOutputsLoop();
groupController.groupShutterLoop();


_programBypass :






]]></ST>
    </Implementation>
    <Method Name="initButtons" Id="{bf7480a3-2217-4091-9e5a-54e832bdb26c}">
      <Declaration><![CDATA[METHOD initButtons
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//button2(ID:= 1,	digitalInputUp:= GVL.b_button_4,	digitalInputDown:= GVL.b_button_5,down_outputs:=arr5, up_outputs:=arr6); //shutter switch
 
//button1(ID := 1, digitalInput := GVL.b_button_4, small_outputs := arr1,	medium_outputs := arr2,	big_outputs := arr3,
//	superstrong_outputs := arr4, 	levelsManaged := 4,	defaultDayOutput := E_OutputLevel.big,	defaultNightOutput := E_OutputLevel.small); //light switch
	
	
//button1(ID:= 1, digitalInput := GVL.b_button_4, outputs := arr1, defaultFirstClickDirection := E_Direction.UP);
	
//button1(digitalInput:= GVL.b_button_4, ID:=1, name:='goscinny', outputs := arr1, runAsYouPress := FALSE);


	]]></ST>
      </Implementation>
    </Method>
    <Method Name="initializeButtons" Id="{8a6ffdb9-baa8-41fd-856d-9b1a94c3eee6}">
      <Declaration><![CDATA[METHOD initializeButtons
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//TODO ATTENTION ponizsze DIN inputy sa niesprawdzone

//wlacznik_ogrzewania_lustra(ID:= 99, name:= 'lustro', digitalInput:=GVL.din_21, holdTime:=T#8S, outputs:= GVL.douts_44_ogrzewanie_lustra,
//withHold:=FALSE, runAsYouPress := FALSE);

//wlacznik_bramy_garazowej(ID:=123, defaultFirstClickDirection:=E_Direction.UP, digitalInput:=GVL.din_21, outputs:=GVL.douts_44_ogrzewanie_lustra, name:='brama garazowa', withReturn:=FALSE);
	

wlacznik_17_schody(ID:=17, name:='Wlacznik swiatla przy schodach', 
		digitalInput:=GVL.din_22, small_outputs:= GVL.douts_ledy2, medium_outputs:= GVL.douts_ledy3,
		levelsManaged:= 2, 
		defaultDayOutput:=E_OutputLevel.MEDIUM, defaultNightOutput:=E_OutputLevel.SMALL);	
wlaczniki_swiatel[1] := ADR(wlacznik_17_schody);

wlacznik_12_pralnia(ID:=12, name:='Wlacznik swiatla w pralni', 
		digitalInput:=GVL.din_21, small_outputs:= GVL.douts_ledy1,
		levelsManaged:= 1, 
		defaultDayOutput:=E_OutputLevel.SMALL, defaultNightOutput:=E_OutputLevel.SMALL);
wlaczniki_swiatel[2] := ADR(wlacznik_12_pralnia);
		

(* ShutterSwitch - pozostalo odkomentowac i podpiąć odpowiednie we/wy

wlacznik_1_zaluzja_pralnia(ID:=1, name:='Wlacznik zaluzji okna w pralni', 
		digitalInputUp:=GVL.din_21,
		digitalInputDown:=GVL.din_22,
		up_outputs:=GVL.douts_1_zaluzja_pralnia_w_gore, 
		down_outputs:=GVL.douts_2_zaluzja_pralnia_w_dol, 
		shortTime:=T#250MS, longTime:= T#30S);
wlaczniki_rolet_i_zaluzji[1] := ADR(wlacznik_1_zaluzja_pralnia);

wlacznik_2_zaluzje_kuchnia(ID:=2, name:='Wlacznik zaluzji okna naroznego w kuchni', 
		digitalInputUp:=GVL.din_23, 
		digitalInputDown:=GVL.din_24,
		up_outputs:=GVL.douts_3_zaluzja_okno_narozne_kuchnia_w_gore, 
		down_outputs:=GVL.douts_4_zaluzja_okno_narozne_kuchnia_w_dol, 
		shortTime:=T#250MS, longTime:= T#30S);
wlaczniki_rolet_i_zaluzji[2] := ADR(wlacznik_2_zaluzje_kuchnia);

wlacznik_3_zaluzje_wykusz(ID:=3, name:='Wlacznik zaluzji przeszklenia wykuszu w salonie', 
		digitalInputUp:=GVL.din_25, 
		digitalInputDown:=GVL.din_26,
		up_outputs:=GVL.douts_5_zaluzja_wykusz_w_gore, 
		down_outputs:=GVL.douts_6_zaluzja_wykusz_w_dol, 
		shortTime:=T#250MS, longTime:= T#60S);		
wlaczniki_rolet_i_zaluzji[3] := ADR(wlacznik_3_zaluzje_wykusz);

wlacznik_4_zaluzja_slide(ID:=4, name:='Wlacznik zaluzji drzwi slide na taras', 
		digitalInputUp:=GVL.din_27, 
		digitalInputDown:=GVL.din_28,
		up_outputs:=GVL.douts_7_zaluzja_slide_w_gore, 
		down_outputs:=GVL.douts_8_zaluzja_slide_w_dol, 
		shortTime:=T#250MS, longTime:= T#60S);				
wlaczniki_rolet_i_zaluzji[4] := ADR(wlacznik_4_zaluzja_slide);	

wlacznik_5_zaluzja_gabinet(ID:=5, name:='Wlacznik zaluzji okna w gabinecie', 
		digitalInputUp:=GVL.din_29,
		digitalInputDown:=GVL.din_30,
		up_outputs:=GVL.douts_9_zaluzja_gabinet_w_gore, 
		down_outputs:=GVL.douts_10_zaluzja_gabinet_w_dol, 
		shortTime:=T#250MS, longTime:= T#30S);
wlaczniki_rolet_i_zaluzji[5] := ADR(wlacznik_5_zaluzja_gabinet);

wlacznik_6_zaluzja_balkon(ID:=6, name:='Wlacznik zaluzji drzwi sypialni z balkonem', 
		digitalInputUp:=GVL.din_31,
		digitalInputDown:=GVL.din_32,
		up_outputs:=GVL.douts_11_zaluzja_balkon_w_gore, 
		down_outputs:=GVL.douts_12_zaluzja_balkon_w_dol, 
		shortTime:=T#250MS, longTime:= T#60S);
wlaczniki_rolet_i_zaluzji[6] := ADR(wlacznik_6_zaluzja_balkon);

wlacznik_7_zaluzja_nad_tarasem(ID:=7, name:='Wlacznik zaluzji drzwi w sypialni rodzicow', 
		digitalInputUp:=GVL.din_33,
		digitalInputDown:=GVL.din_34,
		up_outputs:=GVL.douts_13_zaluzja_nad_wykuszem_w_gore, 
		down_outputs:=GVL.douts_14_zaluzja_nad_wykuszem_w_dol, 
		shortTime:=T#250MS, longTime:= T#60S);
wlaczniki_rolet_i_zaluzji[7] := ADR(wlacznik_7_zaluzja_nad_tarasem);

wlacznik_8_zaluzja_okno_bez_balkonu(ID:=8, name:='Wlacznik zaluzji okna w sypialni bez balkonu', 
		digitalInputUp:=GVL.din_33,
		digitalInputDown:=GVL.din_34,
		up_outputs:=GVL.douts_15_zaluzja_okno_bez_balkonu_w_gore, 
		down_outputs:=GVL.douts_16_zaluzja_okno_bez_balkonu_w_dol, 
		shortTime:=T#250MS, longTime:= T#30S);
wlaczniki_rolet_i_zaluzji[8] := ADR(wlacznik_8_zaluzja_okno_bez_balkonu);

wlacznik_9_roleta_kotlownia(ID:=9, name:='Wlacznik rolety okna w kotlowni', 
		digitalInputUp:=GVL.din_35,
		digitalInputDown:=GVL.din_36,
		up_outputs:=GVL.douts_17_roleta_kotlownia_w_gore, 
		down_outputs:=GVL.douts_18_roleta_kotlownia_w_dol, 
		shortTime:=T#250MS, longTime:= T#25S);
wlaczniki_rolet_i_zaluzji[9] := ADR(wlacznik_9_roleta_kotlownia);

wlacznik_10_roleta_warsztat(ID:=10, name:='Wlacznik rolety okna w warsztacie', 
		digitalInputUp:=GVL.din_37,
		digitalInputDown:=GVL.din_38,
		up_outputs:=GVL.douts_19_roleta_warsztat_w_gore, 
		down_outputs:=GVL.douts_20_roleta_warsztat_w_dol, 
		shortTime:=T#250MS, longTime:= T#25S);
wlaczniki_rolet_i_zaluzji[10] := ADR(wlacznik_10_roleta_warsztat);

wlacznik_11_rolety_garaz(ID:=11, name:='Wlacznik rolety okna w kotlowni', 
		digitalInputUp:=GVL.din_39,
		digitalInputDown:=GVL.din_40,
		up_outputs:=GVL.douts_21_roleta_kotlownia_w_gore, 
		down_outputs:=GVL.douts_22_roleta_kotlownia_w_dol, 
		shortTime:=T#250MS, longTime:= T#25S);
wlaczniki_rolet_i_zaluzji[11] := ADR(wlacznik_11_rolety_garaz);

*)

//prosteWlaczniki[1] := wlacznik_ogrzewania_lustra; 

//wlacznikiTrojpozycyjne[1] := wlacznik_bramy_garazowej;]]></ST>
      </Implementation>
    </Method>
    <Method Name="inputsOutputsLoop" Id="{5ddbf680-25b6-4be3-b0a7-c03717331c9d}">
      <Declaration><![CDATA[METHOD inputsOutputsLoop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//TODO pozamieniac dout_1_zaluzja_pralnia_w_gore na konkretny indeksowany DOUT

(* 
wlaczniki_rolet_i_zaluzji[1]^.loop();
	GVL.dout_1_zaluzja_pralnia_w_gore := GVL.douts_1_zaluzja_pralnia_w_gore[1];
	GVL.dout_2_zaluzja_pralnia_w_dol := GVL.douts_2_zaluzja_pralnia_w_dol[1];
	
 wlaczniki_rolet_i_zaluzji[2]^.loop();
	GVL.dout_3_zaluzja_okno_narozne_kuchnia_w_gore := GVL.douts_3_zaluzja_okno_narozne_kuchnia_w_gore[1];
	GVL.dout_4_zaluzja_okno_narozne_kuchnia_w_dol := GVL.douts_4_zaluzja_okno_narozne_kuchnia_w_dol[1];
	
wlaczniki_rolet_i_zaluzji[3]^.loop();
	GVL.dout_5_zaluzja_wykusz_w_gore := GVL.douts_3_zaluzja_okno_narozne_kuchnia_w_gore[1];
	GVL.dout_6_zaluzja_wykusz_w_dol := GVL.douts_6_zaluzja_wykusz_w_dol[1];
	
wlaczniki_rolet_i_zaluzji[4]^.loop();
	GVL.dout_7_zaluzja_slide_w_gore := GVL.douts_7_zaluzja_slide_w_gore[1];
	GVL.dout_8_zaluzja_slide_w_dol := GVL.douts_8_zaluzja_slide_w_dol[1];
*)

//TODO pozostale wlaczniki rolet


wlaczniki_swiatel[1]^.loop();
	GVL.b_led_2 := GVL.douts_ledy2[1];
	GVL.b_led_3 := GVL.douts_ledy3[1];
	
wlaczniki_swiatel[2]^.loop();
	GVL.b_led_1 := GVL.douts_ledy1[1];


]]></ST>
      </Implementation>
    </Method>
    <Method Name="systemService" Id="{e4d1bead-f766-4caa-a18e-e267b07bd01c}">
      <Declaration><![CDATA[METHOD systemService
VAR_INPUT
END_VAR

VAR
	neededHigh : BOOL := FALSE;
	neededLow : BOOL := TRUE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[neededHigh := GVL.din_21;//_1;
neededLow := GVL.din_22;//_2;

IF serviceMode THEN
	JMP _wait_for_service_mode_exit;
END_IF

ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'Device booted', '');
ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'To enter service mode next time set DIGITAL INPUT 1 to TRUE and DIGITAL INPUT 2 to FALSE', '');
IF neededHigh AND NOT neededLow THEN
	ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'Service mode entered', '');
	serviceMode := TRUE;
END_IF

_wait_for_service_mode_exit :

IF neededLow THEN
	ADSLOGSTR(ADSLOG_MSGTYPE_ERROR, 'Exiting service mode', '');
	serviceMode := FALSE;
END_IF

]]></ST>
      </Implementation>
    </Method>
